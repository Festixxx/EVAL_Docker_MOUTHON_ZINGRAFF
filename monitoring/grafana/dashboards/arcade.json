{
  "title": "Retro Arcade Leaderboard",
  "uid": "arcade-main",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Trafic – Requêtes/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(http_requests_total[1m])", "legendFormat": "{{route}} {{method}} {{status}}" }]
    },
    {
      "id": 2,
      "title": "Latence p95 (ms)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[2m])) * 1000", "legendFormat": "p95 {{route}}" }]
    },
    {
      "id": 3,
      "title": "Taux d'erreurs 5xx (%)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "100 * rate(http_requests_total{status=~\"5..\"}[2m]) / rate(http_requests_total[2m])", "legendFormat": "Erreurs 5xx %" }]
    },
    {
      "id": 4,
      "title": "Tentatives de triche (rejets/s)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(scores_rejected_total[1m])", "legendFormat": "{{game}} – {{reason}}" }]
    },
    {
      "id": 5,
      "title": "Scores soumis/s (par jeu)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(scores_submitted_total[1m])", "legendFormat": "{{game}}" }]
    },
    {
      "id": 6,
      "title": "Consultations de classements/s",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [{ "expr": "rate(leaderboard_views_total[1m])", "legendFormat": "{{game}}" }]
    },
    {
      "id": 7,
      "title": "Service UP/DOWN",
      "type": "stat",
      "gridPos": { "x": 0, "y": 24, "w": 6, "h": 4 },
      "targets": [{ "expr": "up{job=\"arcade-api\"}", "legendFormat": "API" }],
      "options": { "colorMode": "background", "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } }
    }
  ]
}
